<Window x:Class="RegionToShare.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RegionToShare"
        xmlns:properties="clr-namespace:RegionToShare.Properties"
        Title="{x:Static properties:Resources.Settings_Title}"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#252526" Foreground="#F1F1F1">
  <Window.Resources>
    <ResourceDictionary Source="DarkTheme.xaml" />
  </Window.Resources>
  <StackPanel Margin="10" DataContext="{x:Static properties:Settings.Default}">
    <StackPanel.Resources>
      <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="5" />
      </Style>
      <Style TargetType="TextBlock" x:Key="Label">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,3,10,3" />
      </Style>
      <Style TargetType="TextBlock" x:Key="Hint">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="#999999" />
        <Setter Property="Margin" Value="0,2,0,3" />
      </Style>
    </StackPanel.Resources>

    <GroupBox Header="{x:Static properties:Resources.Settings_General}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static properties:Resources.Settings_ThemeColor}" />
        <local:ColorBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Color="{Binding ThemeColor}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static properties:Resources.Settings_FramesPerSecond}" />
        <ComboBox Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" VerticalAlignment="Center"
                  SelectedItem="{Binding FramesPerSecond}"
                  ItemStringFormat="{x:Static properties:Resources.FramesPerSecondFormat}"
                  ItemsSource="{x:Static local:MainWindow.SupportedFramesPerSecond}" />

        <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,3"
                  Content="{x:Static properties:Resources.Settings_DrawShadowCursor}"
                  IsChecked="{Binding DrawShadowCursor}" />

        <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,3"
                  Content="{x:Static properties:Resources.Settings_StartActivated}"
                  IsChecked="{Binding StartActivated}" />

        <CheckBox Grid.Row="6" Grid.Column="1" Margin="0,3"
                  Content="{x:Static properties:Resources.Settings_ShowWindowButtons}"
                  IsChecked="{Binding ShowWindowButtons}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static properties:Resources.Settings_Language}" />
        <ComboBox Grid.Row="4" Grid.Column="1" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center"
                  ItemsSource="{x:Static local:SettingsWindow.Languages}"
                  DisplayMemberPath="Value" SelectedValuePath="Key"
                  SelectedValue="{Binding Language}" />
        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Hint}"
                   Text="{x:Static properties:Resources.Settings_LanguageRestart}"
                   Visibility="{Binding IsRestartRequired, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:SettingsWindow.BooleanToVisibility}}" />
      </Grid>
    </GroupBox>

    <GroupBox Header="{x:Static properties:Resources.Settings_Hotkeys}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static properties:Resources.Settings_FitWindowHotkey}" />
        <local:HotkeyBox Grid.Row="0" Grid.Column="1" x:Name="FitWindowHotkeyBox" VerticalAlignment="Center"
                         Hotkey="{Binding FitWindowHotkey}"
                         NoneText="{x:Static properties:Resources.Hotkey_None}"
                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                         LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
        <StackPanel Grid.Row="1" Grid.Column="1">
          <TextBlock Style="{StaticResource Hint}" Foreground="#FF6060"
                     Text="{x:Static properties:Resources.Settings_HotkeyInUse}"
                     Visibility="{Binding IsFitWindowHotkeyInUse, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:SettingsWindow.BooleanToVisibility}}" />
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static properties:Resources.Settings_HotkeyHint}" />
        </StackPanel>
      </Grid>
    </GroupBox>

    <GroupBox Header="{x:Static properties:Resources.Settings_Highlighter}">
      <StackPanel>
        <CheckBox Margin="0,3"
                  Content="{x:Static properties:Resources.Settings_HighlighterEnabled}"
                  IsChecked="{Binding HighlighterEnabled}" />
        <Grid IsEnabled="{Binding HighlighterEnabled}" Margin="0,3,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.Resources>
            <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
              <Setter Property="Width" Value="180" />
              <Setter Property="VerticalAlignment" Value="Center" />
              <Setter Property="IsSnapToTickEnabled" Value="True" />
            </Style>
            <Style TargetType="TextBlock" x:Key="SliderValue">
              <Setter Property="VerticalAlignment" Value="Center" />
              <Setter Property="Margin" Value="8,0,0,0" />
            </Style>
          </Grid.Resources>

          <CheckBox Grid.Row="0" Grid.Column="1" Margin="0,3"
                    Content="{x:Static properties:Resources.Settings_HighlighterOnScreen}"
                    IsChecked="{Binding HighlighterOnScreen}" />
          <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                    Content="{x:Static properties:Resources.Settings_HighlighterInShare}"
                    IsChecked="{Binding HighlighterInShare}" />

          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static properties:Resources.Settings_HighlighterColor}" />
          <local:ColorBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Color="{Binding HighlighterColor}" />

          <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static properties:Resources.Settings_HighlighterOpacity}" />
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
            <Slider Minimum="10" Maximum="100" TickFrequency="5" Value="{Binding HighlighterOpacity}" />
            <TextBlock Style="{StaticResource SliderValue}" Text="{Binding HighlighterOpacity, StringFormat={}{0} %}" />
          </StackPanel>

          <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static properties:Resources.Settings_HighlighterDiameter}" />
          <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
            <Slider Minimum="10" Maximum="200" TickFrequency="2" Value="{Binding HighlighterDiameter}" />
            <TextBlock Style="{StaticResource SliderValue}" Text="{Binding HighlighterDiameter, StringFormat={}{0} px}" />
          </StackPanel>

          <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static properties:Resources.Settings_HighlighterOuterThickness}" />
          <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
            <Slider Minimum="1" Maximum="20" TickFrequency="1" Value="{Binding HighlighterOuterThickness}" />
            <TextBlock Style="{StaticResource SliderValue}" Text="{Binding HighlighterOuterThickness, StringFormat={}{0} px}" />
          </StackPanel>

          <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static properties:Resources.Settings_HighlighterThickness}" />
          <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
            <Slider Minimum="1" Maximum="20" TickFrequency="1" Value="{Binding HighlighterThickness}" />
            <TextBlock Style="{StaticResource SliderValue}" Text="{Binding HighlighterThickness, StringFormat={}{0} px}" />
          </StackPanel>

          <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static properties:Resources.Settings_HighlighterLeftClick}" />
          <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
            <local:ColorBox VerticalAlignment="Center" Margin="0,0,10,0" Color="{Binding HighlighterLeftClickColor}" />
            <local:SoundSelector Sound="{Binding HighlighterLeftClickSound}" />
          </StackPanel>

          <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static properties:Resources.Settings_HighlighterRightClick}" />
          <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
            <local:ColorBox VerticalAlignment="Center" Margin="0,0,10,0" Color="{Binding HighlighterRightClickColor}" />
            <local:SoundSelector Sound="{Binding HighlighterRightClickSound}" />
          </StackPanel>

          <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static properties:Resources.Settings_HighlighterClickDuration}" />
          <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal">
            <Slider Minimum="50" Maximum="2000" TickFrequency="50" Value="{Binding HighlighterClickDuration}" />
            <TextBlock Style="{StaticResource SliderValue}" Text="{Binding HighlighterClickDuration, StringFormat={}{0} ms}" />
          </StackPanel>

          <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static properties:Resources.Settings_HighlighterVolume}" />
          <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal">
            <Slider Minimum="0" Maximum="100" TickFrequency="5" Value="{Binding HighlighterVolume}" />
            <TextBlock Style="{StaticResource SliderValue}" Text="{Binding HighlighterVolume, StringFormat={}{0} %}" />
          </StackPanel>

          <TextBlock Grid.Row="11" Grid.Column="1" Style="{StaticResource Hint}"
                     Text="{x:Static properties:Resources.Settings_HighlighterSoundHint}" />
        </Grid>
      </StackPanel>
    </GroupBox>

    <Button HorizontalAlignment="Right" MinWidth="80" Padding="10,3" IsCancel="True"
            Content="{x:Static properties:Resources.Settings_Close}"
            Click="CloseButton_Click" />
  </StackPanel>
</Window>
