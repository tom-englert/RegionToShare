<Window x:Class="RegionToShare.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RegionToShare"
        xmlns:properties="clr-namespace:RegionToShare.Properties"
        xmlns:toms="urn:TomsToolbox"
        xmlns:styles="urn:TomsToolbox.Wpf.Styles"
        Title="{x:Static properties:Resources.Settings_Title}"
        Width="600" SizeToContent="Height"
        ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
  <Window.Resources>
    <ResourceDictionary Source="DarkTheme.xaml" />
  </Window.Resources>
  <DockPanel>
    <Grid DockPanel.Dock="Bottom" Margin="10">
      <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" MinWidth="80" Padding="10,3" IsCancel="True"
              Content="{x:Static properties:Resources.Settings_Close}"
              Click="CloseButton_Click" />
    </Grid>

    <TabControl DataContext="{x:Static properties:Settings.Default}" 
                Margin="10,0"
                Loaded="TabControl_Loaded">
      <TabControl.Resources>
        <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Static styles:ResourceKeys.GroupBoxStyle}}">
          <Setter Property="Margin" Value="0,0,0,10" />
          <Setter Property="Padding" Value="5" />
        </Style>
        <Style TargetType="toms:SharedWidthHeaderedContentControl">
          <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
          <Setter Property="TextWrapping" Value="Wrap" />
          <Setter Property="Foreground" Value="LightGray" />
          <Setter Property="Margin" Value="0,3" />
        </Style>
      </TabControl.Resources>

      <TabItem Header="{x:Static properties:Resources.Settings_General}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10">
            <StackPanel Grid.IsSharedSizeScope="True">
              <toms:SharedWidthHeaderedContentControl Header="{x:Static properties:Resources.Settings_ThemeColor}">
                <local:ColorBox VerticalAlignment="Center" HorizontalAlignment="Left" Color="{Binding ThemeColor}" />
              </toms:SharedWidthHeaderedContentControl>

              <toms:SharedWidthHeaderedContentControl Header="{x:Static properties:Resources.Settings_FramesPerSecond}">
                <ComboBox Width="80" HorizontalAlignment="Left" VerticalAlignment="Center"
                          SelectedItem="{Binding FramesPerSecond}"
                          ItemStringFormat="{x:Static properties:Resources.FramesPerSecondFormat}"
                          ItemsSource="{x:Static local:MainWindow.SupportedFramesPerSecond}" />
              </toms:SharedWidthHeaderedContentControl>

              <toms:SharedWidthHeaderedContentControl Header="{x:Static properties:Resources.Settings_DrawShadowCursor}">
                <CheckBox IsChecked="{Binding DrawShadowCursor}" />
              </toms:SharedWidthHeaderedContentControl>

              <toms:SharedWidthHeaderedContentControl Header="{x:Static properties:Resources.Settings_StartActivated}">
                <CheckBox IsChecked="{Binding StartActivated}" />
              </toms:SharedWidthHeaderedContentControl>

              <toms:SharedWidthHeaderedContentControl Header="{x:Static properties:Resources.Settings_Language}">
                <ComboBox Width="160" HorizontalAlignment="Left" VerticalAlignment="Center"
                          ItemsSource="{x:Static local:SettingsWindow.Languages}"
                          DisplayMemberPath="Value" SelectedValuePath="Key"
                          SelectedValue="{Binding Language}" />
              </toms:SharedWidthHeaderedContentControl>

              <toms:SharedWidthHeaderedContentControl>
                <TextBlock Style="{StaticResource Hint}"
                           Text="{x:Static properties:Resources.Settings_LanguageRestart}"
                           Visibility="{Binding IsRestartRequired, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:SettingsWindow.BooleanToVisibility}}" />
              </toms:SharedWidthHeaderedContentControl>

              <toms:SharedWidthHeaderedContentControl Header="{x:Static properties:Resources.Settings_ShowWindowButtons}">
                <CheckBox IsChecked="{Binding ShowWindowButtons}" />
              </toms:SharedWidthHeaderedContentControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static properties:Resources.Settings_Hotkeys}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10" Grid.IsSharedSizeScope="True">
            <toms:SharedWidthHeaderedContentControl Header="{x:Static properties:Resources.Settings_FitWindowHotkey}">
              <local:HotkeyBox x:Name="FitWindowHotkeyBox" VerticalAlignment="Center"
                               Hotkey="{Binding FitWindowHotkey}"
                               NoneText="{x:Static properties:Resources.Hotkey_None}"
                               GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                               LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
            </toms:SharedWidthHeaderedContentControl>
            <toms:SharedWidthHeaderedContentControl>
              <StackPanel>
                <TextBlock Style="{StaticResource Hint}" Foreground="#FF6060"
                           Text="{x:Static properties:Resources.Settings_HotkeyInUse}"
                           Visibility="{Binding IsFitWindowHotkeyInUse, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:SettingsWindow.BooleanToVisibility}}" />
                <TextBlock Style="{StaticResource Hint}" Text="{x:Static properties:Resources.Settings_HotkeyHint}" />
              </StackPanel>
            </toms:SharedWidthHeaderedContentControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static properties:Resources.Settings_Highlighter}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10">
            <CheckBox Margin="0,3"
                      Content="{x:Static properties:Resources.Settings_HighlighterEnabled}"
                      IsChecked="{Binding HighlighterEnabled}" />
            <StackPanel IsEnabled="{Binding HighlighterEnabled}" Margin="0,3,0,0" Grid.IsSharedSizeScope="True">
              <StackPanel.Resources>
                <Style TargetType="Slider" BasedOn="{StaticResource {x:Static styles:ResourceKeys.SliderStyle}}">
                  <Setter Property="Width" Value="180" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="IsSnapToTickEnabled" Value="True" />
                </Style>
                <Style TargetType="TextBlock" x:Key="SliderValue">
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="Margin" Value="8,0,0,0" />
                </Style>
              </StackPanel.Resources>

              <toms:SharedWidthHeaderedContentControl Header="{x:Static properties:Resources.Settings_HighlighterOnScreen}">
                <CheckBox IsChecked="{Binding HighlighterOnScreen}" />
              </toms:SharedWidthHeaderedContentControl>
              <toms:SharedWidthHeaderedContentControl Header="{x:Static properties:Resources.Settings_HighlighterInShare}">
                <CheckBox IsChecked="{Binding HighlighterInShare}" />
              </toms:SharedWidthHeaderedContentControl>

              <toms:SharedWidthHeaderedContentControl
                Header="{x:Static properties:Resources.Settings_HighlighterColor}">
                <local:ColorBox VerticalAlignment="Center" HorizontalAlignment="Left"
                                Color="{Binding HighlighterColor}" />
              </toms:SharedWidthHeaderedContentControl>

              <toms:SharedWidthHeaderedContentControl
                Header="{x:Static properties:Resources.Settings_HighlighterOpacity}">
                <StackPanel Orientation="Horizontal">
                  <Slider Minimum="10" Maximum="100" TickFrequency="5" Value="{Binding HighlighterOpacity}" />
                  <TextBlock Style="{StaticResource SliderValue}"
                             Text="{Binding HighlighterOpacity, StringFormat={}{0} %}" />
                </StackPanel>
              </toms:SharedWidthHeaderedContentControl>

              <toms:SharedWidthHeaderedContentControl
                Header="{x:Static properties:Resources.Settings_HighlighterDiameter}">
                <StackPanel Orientation="Horizontal">
                  <Slider Minimum="10" Maximum="200" TickFrequency="2" Value="{Binding HighlighterDiameter}" />
                  <TextBlock Style="{StaticResource SliderValue}"
                             Text="{Binding HighlighterDiameter, StringFormat={}{0} px}" />
                </StackPanel>
              </toms:SharedWidthHeaderedContentControl>

              <toms:SharedWidthHeaderedContentControl
                Header="{x:Static properties:Resources.Settings_HighlighterOuterThickness}">
                <StackPanel Orientation="Horizontal">
                  <Slider Minimum="1" Maximum="20" TickFrequency="1" Value="{Binding HighlighterOuterThickness}" />
                  <TextBlock Style="{StaticResource SliderValue}"
                             Text="{Binding HighlighterOuterThickness, StringFormat={}{0} px}" />
                </StackPanel>
              </toms:SharedWidthHeaderedContentControl>

              <toms:SharedWidthHeaderedContentControl
                Header="{x:Static properties:Resources.Settings_HighlighterThickness}">
                <StackPanel Orientation="Horizontal">
                  <Slider Minimum="1" Maximum="20" TickFrequency="1" Value="{Binding HighlighterThickness}" />
                  <TextBlock Style="{StaticResource SliderValue}"
                             Text="{Binding HighlighterThickness, StringFormat={}{0} px}" />
                </StackPanel>
              </toms:SharedWidthHeaderedContentControl>

              <toms:SharedWidthHeaderedContentControl
                Header="{x:Static properties:Resources.Settings_HighlighterLeftClick}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <local:ColorBox VerticalAlignment="Center" Margin="0,0,10,0"
                                  Color="{Binding HighlighterLeftClickColor}" />
                  <local:SoundSelector Sound="{Binding HighlighterLeftClickSound}" />
                </StackPanel>
              </toms:SharedWidthHeaderedContentControl>

              <toms:SharedWidthHeaderedContentControl
                Header="{x:Static properties:Resources.Settings_HighlighterRightClick}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <local:ColorBox VerticalAlignment="Center" Margin="0,0,10,0"
                                  Color="{Binding HighlighterRightClickColor}" />
                  <local:SoundSelector Sound="{Binding HighlighterRightClickSound}" />
                </StackPanel>
              </toms:SharedWidthHeaderedContentControl>

              <toms:SharedWidthHeaderedContentControl
                Header="{x:Static properties:Resources.Settings_HighlighterClickDuration}">
                <StackPanel Orientation="Horizontal">
                  <Slider Minimum="50" Maximum="2000" TickFrequency="50" Value="{Binding HighlighterClickDuration}" />
                  <TextBlock Style="{StaticResource SliderValue}"
                             Text="{Binding HighlighterClickDuration, StringFormat={}{0} ms}" />
                </StackPanel>
              </toms:SharedWidthHeaderedContentControl>

              <toms:SharedWidthHeaderedContentControl
                Header="{x:Static properties:Resources.Settings_HighlighterVolume}">
                <StackPanel Orientation="Horizontal">
                  <Slider Minimum="0" Maximum="100" TickFrequency="5" Value="{Binding HighlighterVolume}" />
                  <TextBlock Style="{StaticResource SliderValue}"
                             Text="{Binding HighlighterVolume, StringFormat={}{0} %}" />
                </StackPanel>
              </toms:SharedWidthHeaderedContentControl>

              <toms:SharedWidthHeaderedContentControl>
                <TextBlock Style="{StaticResource Hint}"
                           Text="{x:Static properties:Resources.Settings_HighlighterSoundHint}" />
              </toms:SharedWidthHeaderedContentControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>