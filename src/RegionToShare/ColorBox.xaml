<UserControl x:Class="RegionToShare.ColorBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RegionToShare"
             xmlns:properties="clr-namespace:RegionToShare.Properties">
  <StackPanel Orientation="Horizontal">
    <ComboBox Width="120" VerticalAlignment="Center" IsEditable="True"
              ItemsSource="{Binding Names, RelativeSource={RelativeSource AncestorType=local:ColorBox}}"
              TextSearch.TextPath="Name"
              ToolTip="{x:Static properties:Resources.Settings_ColorHint}">
      <ComboBox.ItemTemplate>
        <DataTemplate DataType="{x:Type local:NamedColor}">
          <StackPanel Orientation="Horizontal">
            <Border Width="12" Height="12" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
              <Border.Background>
                <SolidColorBrush Color="{Binding Color}" />
              </Border.Background>
            </Border>
            <Decorator Width="8" />
            <TextBlock Text="{Binding Name}" />
          </StackPanel>
        </DataTemplate>
      </ComboBox.ItemTemplate>
      <ComboBox.Text>
        <Binding Path="Color" RelativeSource="{RelativeSource AncestorType=local:ColorBox}" UpdateSourceTrigger="PropertyChanged">
          <Binding.ValidationRules>
            <local:ColorValidationRule />
          </Binding.ValidationRules>
        </Binding>
      </ComboBox.Text>
    </ComboBox>
    <Decorator Width="8" />
    <Button Padding="2" VerticalAlignment="Center"
            ToolTip="{x:Static properties:Resources.Settings_ChooseColor}"
            Click="PickButton_Click">
      <Border Width="16" Height="16" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
              Background="{Binding Color, RelativeSource={RelativeSource AncestorType=local:ColorBox}, Converter={x:Static local:ColorBrushConverter.Default}}" />
    </Button>
  </StackPanel>
</UserControl>