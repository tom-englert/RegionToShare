<UserControl x:Class="RegionToShare.ColorBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RegionToShare"
             xmlns:properties="clr-namespace:RegionToShare.Properties">
  <StackPanel Orientation="Horizontal">
    <TextBox x:Name="ColorTextBox"
             Width="90" VerticalAlignment="Center"
             ToolTip="{x:Static properties:Resources.Settings_ColorHint}"
             >
      <TextBox.Text>
        <Binding Path="Color" RelativeSource="{RelativeSource AncestorType=local:ColorBox}" UpdateSourceTrigger="PropertyChanged">
          <Binding.ValidationRules>
            <local:ColorValidationRule />
          </Binding.ValidationRules>
        </Binding>
      </TextBox.Text>
    </TextBox>
    <Button Margin="5,0,0,0" Padding="2" VerticalAlignment="Center"
            ToolTip="{x:Static properties:Resources.Settings_ChooseColor}"
            Click="PickButton_Click">
      <Border Width="18" Height="16" BorderThickness="1" BorderBrush="#686868"
              Background="{Binding Color, RelativeSource={RelativeSource AncestorType=local:ColorBox}, Converter={x:Static local:ColorBrushConverter.Default}}" />
    </Button>
  </StackPanel>
</UserControl>
