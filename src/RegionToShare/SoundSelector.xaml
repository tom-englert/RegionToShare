<UserControl x:Class="RegionToShare.SoundSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="clr-namespace:RegionToShare.Properties">
  <StackPanel Orientation="Horizontal">
    <ComboBox x:Name="SoundComboBox"
              Width="120" VerticalAlignment="Center"
              DisplayMemberPath="Value"
              SelectionChanged="SoundComboBox_SelectionChanged" />
    <Button Margin="5,0,0,0" Padding="4,0" VerticalAlignment="Center"
            ToolTip="{x:Static properties:Resources.Sound_Play}"
            Click="PlayButton_Click">
      <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" />
    </Button>
    <TextBlock x:Name="FileNameText"
               Margin="5,0,0,0" MaxWidth="110" VerticalAlignment="Center"
               TextTrimming="CharacterEllipsis" />
  </StackPanel>
</UserControl>
